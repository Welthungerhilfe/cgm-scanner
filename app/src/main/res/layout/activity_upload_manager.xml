<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                android:paddingEnd="5dp"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="17dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_overview"
                android:textColor="@color/colorBlack"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_stdscan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_overview"
                android:textColor="@color/colorBlack"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_upload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_overview"
                    android:textColor="@color/colorBlack"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_upload_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/colorBlack"
                    android:textSize="16sp"
                    android:layout_toRightOf="@+id/tv_upload"
                    android:layout_marginLeft="8dp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/contextMenuButton"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="5dp"
                    android:contentDescription="@string/content_image"
                    android:src="@drawable/ic_context_menu"
                    app:tint="@color/colorGreyDark" />
            </RelativeLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_upload_speed"
                    android:textColor="@color/colorBlack" />

                <TextView
                    android:id="@+id/txtUploadSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorGreen" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_upload_expect"
                    android:textColor="@color/colorBlack" />

                <TextView
                    android:id="@+id/txtExpectTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorGreen" />

            </LinearLayout>

           <!-- <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_total_size"
                    android:textColor="@color/colorBlack" />

                <TextView
                    android:id="@+id/txtTotalSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack" />

            </LinearLayout>-->

           <!-- <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_uploaded_size"
                    android:textColor="@color/colorBlack" />

                <TextView
                    android:id="@+id/txtUploadedSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack" />

            </LinearLayout>-->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                android:layout_marginTop="22dp"
                android:background="@color/colorGreenTransparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp"
                    android:background="@color/colorGreenTransparent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Files"
                    android:textSize="15sp"
                    android:textColor="@color/colorBlack"></TextView>



                <ProgressBar
                    android:id="@+id/progressOverall"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progress="0" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtUploadedSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TextView 1"
                            android:textSize="12sp"
                            android:textColor="@color/colorGreen" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" of "
                            android:textSize="12sp"
                            android:textColor="@color/colorGreen" />

                        <TextView
                            android:id="@+id/txtTotalSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TextView 3"
                            android:textSize="12sp"
                            android:textColor="@color/colorGreen" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                android:layout_marginTop="22dp"
                android:background="@color/colorGreenTransparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp"
                    android:visibility="gone"
                    android:background="@color/colorGreenTransparent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="META DATA"
                        android:textSize="15sp"
                        android:textColor="@color/colorBlack"></TextView>



                    <ProgressBar
                        android:id="@+id/progressOverall_meta"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:progress="0" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtUploadedSize_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TextView 1"
                            android:textSize="12sp"
                            android:textColor="@color/colorGreen" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" of "
                            android:textSize="12sp"
                            android:visibility="visible"
                            android:textColor="@color/colorGreen" />

                        <TextView
                            android:id="@+id/txtTotalSize_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TextView 3"
                            android:textSize="12sp"
                            android:textColor="@color/colorGreen"
                            android:visibility="gone"/>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>




            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:text="@string/label_upload_status"
                android:textColor="@color/colorBlack"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="visible"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upload_desc"
                android:textSize="12sp"
                android:layout_marginTop="14dp"
                android:visibility="visible"></TextView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                android:layout_marginTop="14dp"
                android:visibility="visible"
                android:background="@color/colorGreenTransparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp"
                    android:background="@color/colorGreenTransparent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp">

                        <TextView
                            android:id="@+id/tv_scan_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Regular Scans"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                        <View
                            android:id="@+id/dotted_line"
                            android:layout_width="1dp"
                            android:layout_height="5dp"
                            android:layout_alignParentBottom="true"
                            android:layout_toLeftOf="@+id/tv_remain_scan"
                            android:layout_toRightOf="@+id/tv_scan_left"
                            android:background="@drawable/dotted_line"
                            android:layout_marginLeft="10dp"/>

                        <TextView
                            android:id="@+id/tv_remain_scan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:text="0"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                    </RelativeLayout>

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:text="Remaining Standardization"
                        android:textSize="15sp"
                        android:layout_marginTop="18dp"
                        android:textColor="@color/colorBlack"
                        android:visibility="gone"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/left_textview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STD Test Scans"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                        <View
                            android:id="@+id/dotted_line_2"
                            android:layout_width="1dp"
                            android:layout_height="5dp"
                            android:layout_alignParentBottom="true"
                            android:layout_marginLeft="10dp"
                            android:layout_toRightOf="@+id/left_textview"
                            android:layout_toLeftOf="@+id/tv_remain_stdscan"
                            android:background="@drawable/dotted_line" />

                        <TextView
                            android:id="@+id/tv_remain_stdscan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:text="0"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                    </RelativeLayout>






                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:text="Offline Result status"
                android:textColor="@color/colorBlack"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="visible"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upload_desc"
                android:textSize="12sp"
                android:layout_marginTop="14dp"
                android:visibility="gone"></TextView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                android:visibility="visible"
                android:layout_marginTop="14dp"
                android:background="@color/colorGreenTransparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp"
                    android:background="@color/colorGreenTransparent">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        >

                        <TextView
                            android:id="@+id/tv_distance_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Distance result remaining"
                            android:textColor="@color/colorBlack"

                            android:textSize="15sp" />

                        <View
                            android:id="@+id/dotted_line_distance"
                            android:layout_width="1dp"
                            android:layout_height="5dp"
                            android:layout_alignParentBottom="true"
                            android:layout_marginLeft="10dp"
                            android:layout_toRightOf="@+id/tv_distance_result"
                            android:layout_toLeftOf="@+id/tv_remain_distance_result"
                            android:background="@drawable/dotted_line" />

                        <TextView
                            android:id="@+id/tv_remain_distance_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:text="0"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="7dp">

                        <TextView
                            android:id="@+id/tv_autodetected_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AutoDetected result remaining"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                        <View
                            android:id="@+id/dotted_line_autodetected"
                            android:layout_width="1dp"
                            android:layout_height="5dp"
                            android:layout_alignParentBottom="true"
                            android:layout_marginLeft="10dp"
                            android:layout_toRightOf="@+id/tv_autodetected_result"
                            android:layout_toLeftOf="@+id/tv_remain_autodetected_result"
                            android:background="@drawable/dotted_line" />

                        <TextView
                            android:id="@+id/tv_remain_autodetected_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:text="0"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="7dp">

                        <TextView
                            android:id="@+id/tv_posescore_results"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PoseScore results remaining"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                        <View
                            android:id="@+id/dotted_line_posescore"
                            android:layout_width="1dp"
                            android:layout_height="5dp"
                            android:layout_alignParentBottom="true"
                            android:layout_toLeftOf="@+id/tv_remain_posescore_results"
                            android:layout_toRightOf="@+id/tv_posescore_results"
                            android:background="@drawable/dotted_line"
                            android:layout_marginLeft="10dp"/>

                        <TextView
                            android:id="@+id/tv_remain_posescore_results"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:text="0"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="7dp">

                        <TextView
                            android:id="@+id/tv_appboundingbox_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AppBoundingBox result remaining"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                        <View
                            android:id="@+id/dotted_line_appboundingbox"
                            android:layout_width="1dp"
                            android:layout_height="5dp"
                            android:layout_alignParentBottom="true"
                            android:layout_marginLeft="10dp"
                            android:layout_toRightOf="@+id/tv_appboundingbox_result"
                            android:layout_toLeftOf="@+id/tv_remain_appboundingbox_result"
                            android:background="@drawable/dotted_line" />

                        <TextView
                            android:id="@+id/tv_remain_appboundingbox_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:text="0"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="7dp">

                        <TextView
                            android:id="@+id/tv_orientation_results"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Orientation results remaining"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                        <View
                            android:id="@+id/dotted_line_orientation"
                            android:layout_width="1dp"
                            android:layout_height="5dp"
                            android:layout_alignParentBottom="true"
                            android:layout_toLeftOf="@+id/tv_remain_orientation_results"
                            android:layout_toRightOf="@+id/tv_orientation_results"
                            android:background="@drawable/dotted_line"
                            android:layout_marginLeft="10dp"/>

                        <TextView
                            android:id="@+id/tv_remain_orientation_results"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:text="0"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp"
                            />

                    </RelativeLayout>








                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerScans"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

    </LinearLayout>
</layout>